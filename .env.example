# ==========================================
# MAPIMS PACS Connect - Environment Config
# ==========================================

# Service Ports
FRONTEND_PORT=1009
BACKEND_PORT=2009
MONGO_PORT=3009
MINIO_API_PORT=4009
MINIO_CONSOLE_PORT=5009

# PACS Core Server
PACS_HOST=http://192.168.101.224
PORT=2009
NODE_ENV=production

# MongoDB Config (Local Port 3009)
MONGODB_URI=mongodb://127.0.0.1:3009/pacs_db
# In Docker Network: mongodb://pacs-mongo:27017/pacs_db
# MongoDB Compass: mongodb://localhost:3009/pacs_db or mongodb://192.168.101.130:3009/pacs_db

# MinIO DICOM Object Storage (Port 4009 API / 5009 Console)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=4009
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin`    
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=pacs-dicom
MINIO_COMPRESS=on
MINIO_COMPRESS_EXTENSIONS=.dcm,.dic,.pdf,.doc,.json,.bin
MINIO_COMPRESS_MIME_TYPES=application/dicom,application/pdf,application/json,binary/octet-stream
# Storage Quota Limits (Strict 25 GB Max for DICOM & Reports)
MAX_STORAGE_GB=25
MAX_CACHE_GB=25

