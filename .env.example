# ==========================================
# MAPIMS PACS Connect - Environment Config Template
# ==========================================

# Service Ports
FRONTEND_PORT=1009
BACKEND_PORT=2009
MONGO_PORT=3009
MINIO_API_PORT=4009
MINIO_CONSOLE_PORT=5009

# PACS Core Server
PACS_HOST=http://192.168.101.224
PORT=2009
NODE_ENV=production

# MongoDB Config (Local Port 3009)
MONGODB_URI=mongodb://127.0.0.1:3009/pacs_db

# MinIO DICOM Object Storage (Port 4009 API / 5009 Console)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=4009
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=pacs-dicom
MINIO_COMPRESS=on
MINIO_COMPRESS_EXTENSIONS=.dcm,.dic,.pdf,.doc,.json,.bin
MINIO_COMPRESS_MIME_TYPES=application/dicom,application/pdf,application/json,binary/octet-stream

# Storage Quota Limits (Strict 25 GB Max for DICOM & Reports)
MAX_STORAGE_GB=25
MAX_CACHE_GB=25

# Role-Based Access Control (RBAC) & JWT Security
JWT_SECRET=your_jwt_secret_key_here

# WhatsApp / WATI Gateway Configuration
WATI_API_TOKEN=your_wati_api_token_here
WATI_TEMPLATE_ID=pacs_reports_new
WATI_ACCESS_TOKEN=Bearer your_wati_jwt_access_token_here
API_ENDPOINT=https://live-mt-server.wati.io/your_tenant_id
